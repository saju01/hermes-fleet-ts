#!/usr/bin/env python3
"""Prepare and open an offline Fleet QR form; never receive credentials here."""
import argparse
import base64
import hashlib
import html
import os
import re
from pathlib import Path
import stat
import subprocess
import sys
import tempfile


class SafeParser(argparse.ArgumentParser):
    def error(self, message):
        # argparse's normal diagnostic repeats argv, which could contain a secret.
        self.exit(2, "Unsupported arguments. Use --help; enter credentials only in the private form.\n")


def main():
    parser = SafeParser(description=__doc__, allow_abbrev=False)
    parser.add_argument('--url', default='', help='Nonsecret existing HTTPS *.ts.net origin')
    parser.add_argument('--name', default='My Hermes', help='Nonsecret display name')
    parser.add_argument('--username', default='', help='Nonsecret existing Hermes username')
    parser.add_argument('--prepare-only', action='store_true', help='Prepare file without opening a browser')
    args = parser.parse_args()
    if len(args.url) > 2048 or len(args.name) > 128 or len(args.username) > 256:
        parser.error('bounds')
    if any(re.search(r'[\x00-\x1f\x7f]', value) for value in [args.url,args.name,args.username]):
        parser.error('control characters')
    if args.url:
        match = re.fullmatch(r'https://([a-z0-9.-]+)(?::([1-9][0-9]{0,4}))?/?', args.url, re.I | re.ASCII)
        if (not match or len(match[1]) > 253 or not match[1].lower().endswith('.ts.net')
                or any(not re.fullmatch(r'[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?', label, re.I | re.ASCII)
                       for label in match[1].split('.')) or (match[2] and int(match[2]) > 65535)):
            parser.error('origin')
    assets = Path(__file__).resolve().parents[1] / 'tools' / 'pairing-qr'
    scripts = []
    hashes = []
    for file in ['vendor/qrcode.js', 'vendor/qrcode_UTF8.js', 'core.js', 'app.js']:
        source = (assets / file).read_text()
        if '</script' in source.lower():
            raise ValueError('Unsafe script source')
        hashes.append("'sha256-" + base64.b64encode(hashlib.sha256(source.encode()).digest()).decode() + "'")
        scripts.append('<script>' + source + '</script>')
    style = (assets / 'style.css').read_text()
    style_hash = "'sha256-" + base64.b64encode(hashlib.sha256(style.encode()).digest()).decode() + "'"
    csp = "default-src 'none'; script-src " + ' '.join(hashes) + "; style-src " + style_hash + "; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; img-src 'none'; media-src 'none'; manifest-src 'none'"
    text = (assets / 'page.html').read_text()
    replacements = {key: html.escape(value, quote=True) for key, value in
                    {'CSP':csp, 'URL':args.url, 'NAME':args.name, 'USERNAME':args.username}.items()}
    replacements.update(STYLE='<style>' + style + '</style>', SCRIPTS=''.join(scripts))
    # One substitution pass: user text resembling a marker is always literal.
    text = re.sub(r'@@(CSP|URL|NAME|USERNAME|STYLE|SCRIPTS)@@', lambda m: replacements[m[1]], text)
    text += '<!-- Bundled QR library license:\n' + (assets / 'vendor' / 'LICENSE').read_text() + '-->\n'
    os.umask(0o077)
    base = Path.home() / 'Library' / 'Application Support' / 'HermesFleet' / 'pairing-qr'
    current = Path.home()
    for part in ['Library', 'Application Support', 'HermesFleet', 'pairing-qr']:
        current = current / part
        if current.is_symlink():
            raise ValueError('Unsafe directory link')
        current.mkdir(exist_ok=True, mode=0o700)
        info = current.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
            raise ValueError('Unsafe directory ownership or write permissions')
    info = base.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise ValueError('Unsafe private directory')
    directory = Path(tempfile.mkdtemp(prefix='pairing-', dir=str(base)))
    page = directory / 'index.html'
    with page.open('x', encoding='utf-8') as stream:
        stream.write(text)
    # Only the nonsecret file path is output. The file never contains entered credentials.
    print(str(page))
    if not args.prepare_only:
        if sys.platform != 'darwin':
            raise ValueError('Open this tool on the Mac')
        subprocess.run(['/usr/bin/open', page.as_uri()], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == '__main__':
    try:
        main()
    except Exception:
        print('Could not prepare or open the private pairing form.', file=sys.stderr)
        sys.exit(1)
